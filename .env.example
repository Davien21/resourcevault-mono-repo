# ---- Shared / API ----
NODE_ENV=development
PORT=7842
MONGODB_URI=mongodb://127.0.0.1:27017/resourcevault
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:7843
API_BASE_URL=http://localhost:7842

# ---- Web (client) ----
# Base URL the browser uses to reach the API.
PUBLIC_API_BASE_URL=http://localhost:7842
# Dev server port for the web client.
WEB_PORT=7843
