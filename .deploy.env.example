# ─────────────────────────────────────────────────────────────────────────────
#  ResourceVault — deployment secrets (LOCAL ONLY)
#
#  NOTE: The `golive` CLI reads ACCOUNT tokens from the global, cross-project
#  file ~/.config/golive/secrets.env (VERCEL_TOKEN, RAILWAY_TOKEN,
#  RESEND_API_KEY, NAMECHEAP_*). Put account tokens there. This file is kept for
#  manual/legacy use and mirrors the same names.
#
#  HOW TO USE:
#    1. Copy this file to ".deploy.env"   (that name is git-ignored)
#         cp .deploy.env.example .deploy.env
#    2. Fill in whichever values you have (you don't need all of them at once).
#    3. Tell me "ready" and I'll source it and continue the deploy.
#
#  Leave anything you don't have yet blank.
# ─────────────────────────────────────────────────────────────────────────────

# ── MongoDB ──────────────────────────────────────────────────────────────────
# OPTION A (recommended): paste Atlas Organization API keys and I provision the
# cluster for you. The names below are exactly what the Atlas CLI reads.
MONGODB_ATLAS_PUBLIC_API_KEY=
MONGODB_ATLAS_PRIVATE_API_KEY=

# OPTION B: if you already created a cluster yourself, just paste the full
# connection string here instead (include the db name "resourcevault"):
#   mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/resourcevault?retryWrites=true&w=majority
MONGODB_URI=

# ── Vercel (frontend) ────────────────────────────────────────────────────────
# vercel.com/account/tokens → Create Token (Full Account)
VERCEL_TOKEN=

# ── Railway (backend) ────────────────────────────────────────────────────────
# railway.com → Account Settings → Tokens → create an ACCOUNT/team token.
# IMPORTANT: use RAILWAY_API_TOKEN (account token), NOT RAILWAY_TOKEN (project token).
RAILWAY_API_TOKEN=

# ── Resend (email send + inbound) ────────────────────────────────────────────
# resend.com/api-keys → Create API Key (Full access, to create domains)
RESEND_API_KEY=

# ── Namecheap (domain / DNS) ─────────────────────────────────────────────────
# Profile → Tools → Namecheap API Access (enable it, whitelist 34.243.17.105)
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_USERNAME=
DOMAIN=
