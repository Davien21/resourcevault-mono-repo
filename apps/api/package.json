{
  "name": "@resourcevault/api",
  "version": "1.0.0",
  "description": "ResourceVault REST API",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch api/index.ts",
    "start": "tsx api/index.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "build": "echo 'API runs via tsx — no build step'"
  },
  "dependencies": {
    "@resourcevault/config": "workspace:*",
    "@resourcevault/db": "workspace:*",
    "@resourcevault/types": "workspace:*",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.15.2",
    "morgan": "^1.10.0",
    "tsx": "^4.19.4",
    "zod": "^3.25.20"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.0",
    "typescript": "^5.8.3"
  }
}
